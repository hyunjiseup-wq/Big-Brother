# 디스코드 봇 토큰 (Discord Developer Portal에서 발급)
DISCORD_BOT_TOKEN=여기에_봇_토큰_입력

# Gemini API 키 (https://aistudio.google.com/apikey 에서 무료 발급, 1차 판단용)
GEMINI_API_KEY=여기에_Gemini_API_키_입력

# Groq API 키 (https://console.groq.com/keys 에서 무료 발급, Gemini 한도초과/오류 시 폴백용)
GROQ_API_KEY=여기에_Groq_API_키_입력

# 선택: 다른 커뮤니티용 UTF-8 JSON 정책. 비우면 config.py 기본 규칙을 사용합니다.
# POLICY_FILE=C:\path\to\community-policy.json

# 실시간 AI 판단 순서. 로컬 우선이면 아래 기본값을 사용합니다.
# Ollama가 없거나 꺼져 있으면 자동으로 Gemini/Groq로 넘어갑니다.
REALTIME_PROVIDER_ORDER=ollama,gemini,groq

# 관리자/로그 채널 ID (제재 로그를 남길 채널)
LOG_CHANNEL_ID=

# 배치 감사 리포트를 보낼 채널 ID (선택, 비워두면 로컬 파일로만 저장됨)
REPORT_CHANNEL_ID=

# KPI 월간/분기/연간 요약을 게시할 관리자 채널 (선택).
# 비우면 REPORT_CHANNEL_ID, 그것도 비어 있으면 LOG_CHANNEL_ID를 사용합니다.
KPI_REPORT_CHANNEL_ID=

# 상시 열람 KPI 대시보드 연결(선택). 사이트 배포 후 받은 HTTPS 주소와 수집 토큰을 입력합니다.
# INGEST_URL과 INGEST_TOKEN은 반드시 함께 설정해야 하며, 원문/유저/메시지 ID는 전송하지 않습니다.
KPI_DASHBOARD_PUBLIC_URL=
KPI_DASHBOARD_INGEST_URL=
KPI_DASHBOARD_INGEST_TOKEN=

# 익명화된 제재 로그를 공개할 채널 ID (선택, 비워두면 비활성화)
# 유저 식별 정보 없이 위반 등급/유형/조치만 게시되어 운영 투명성을 높입니다
PUBLIC_LOG_CHANNEL_ID=

# SQLite 저장 경로 (선택). OneDrive/Dropbox 밖의 로컬 경로 권장.
# 예: C:\Users\사용자명\AppData\Local\DiscordAutoMod\automod.db
AUTOMOD_DB_PATH=

# 배치 감사 대상 채널 ID 목록 (선택, 쉼표로 구분). 비워두면 배치 감사 비활성화.
# 예: WATCHED_CHANNEL_IDS=123456789012345678,234567890123456789
WATCHED_CHANNEL_IDS=

# 같은 서버 음성채널 초대 링크를 허용할 팀원찾기 텍스트 채널 ID (쉼표 구분)
INTERNAL_VOICE_INVITE_SOURCE_CHANNEL_IDS=

# 게임 내 플리마켓 거래 대화 문맥을 함께 확인할 물물교환 채널 ID와 이름 (쉼표 구분)
# 포럼 채널 ID를 넣으면 그 아래 거래 스레드에도 자동 적용됩니다.
BARTER_CHANNEL_IDS=1506874360886198363
BARTER_CHANNEL_NAMES=물물교환
